# ==========================================
# Configurações do Ambiente - RAG Tech Docs
# Copie este arquivo para .env e preencha os valores
# ==========================================

# 1. API OpenAI (Embeddings e LLM)
OPENAI_API_KEY=sua_chave_openai_aqui

# 2. Banco de Dados PostgreSQL com pgvector
# Padrão local via Docker: postgresql://usuario:senha@host:porta/nome_do_banco
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_tech_docs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_tech_docs

# 3. Configurações da Aplicação
ENVIRONMENT=development
LOG_LEVEL=INFO

