# ==========================================
# Configurações do Ambiente - RAG Tech Docs
# Copie este arquivo para .env e preencha os valores
# ==========================================

# 1. Provedor de IA (Embeddings e LLM) — compatível com o SDK da OpenAI.
# Escolha UMA das opções abaixo e comente a outra.

# --- Opção A: Gemini (gratuito, sem cartão — https://aistudio.google.com/apikey) ---
AI_API_KEY=sua_chave_gemini_aqui
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=gemini-embedding-001
CHAT_MODEL=gemini-3.8-flash

# --- Opção B: OpenAI (pago — https://platform.openai.com/api-keys) ---
# AI_API_KEY=sua_chave_openai_aqui
# AI_BASE_URL=
# EMBEDDING_MODEL=text-embedding-3-small
# CHAT_MODEL=gpt-4o-mini

# 2. Banco de Dados PostgreSQL com pgvector
# Padrão local via Docker: postgresql://usuario:senha@host:porta/nome_do_banco
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_tech_docs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag_tech_docs

# 3. Configurações da Aplicação
ENVIRONMENT=development
LOG_LEVEL=INFO
